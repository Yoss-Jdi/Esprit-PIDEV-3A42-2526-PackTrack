<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestioncolis.controllers.DashboardController"
      spacing="0"
      prefWidth="1100" prefHeight="700"
      maxWidth="Infinity" maxHeight="Infinity"
      style="-fx-background-color: #f4f4f4;">

    <!-- Navbar -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: #2c3e50; -fx-padding: 16 28;">
        <Label text="TrackPack"
               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblBonjour"
               style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;"/>
        <Button text="Se déconnecter" onAction="#seDeconnecter"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-font-size: 12px;
                       -fx-cursor: hand; -fx-padding: 8 16;"/>
    </HBox>

    <!-- Zone principale -->
    <VBox alignment="CENTER" spacing="32" VBox.vgrow="ALWAYS"
          style="-fx-padding: 80 100;">

        <Label text="Que souhaitez-vous faire ?"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <HBox spacing="40" alignment="CENTER">

            <!-- Carte Colis -->
            <VBox fx:id="carteColis" spacing="14" alignment="CENTER"
                  style="-fx-background-color: white; -fx-border-color: #ddd;
                         -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-padding: 40 50; -fx-pref-width: 240; -fx-cursor: hand;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);"
                  onMouseClicked="#ouvrirColis">
                <Label text="📦" style="-fx-font-size: 44px;"/>
                <Label text="Colis"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Gérer vos colis"
                       style="-fx-font-size: 13px; -fx-text-fill: #999;"/>
            </VBox>

            <!-- Carte Livraisons -->
            <VBox fx:id="carteLivraisons" spacing="14" alignment="CENTER"
                  style="-fx-background-color: white; -fx-border-color: #ddd;
                         -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-padding: 40 50; -fx-pref-width: 240; -fx-cursor: hand;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);"
                  onMouseClicked="#ouvrirLivraisons">
                <Label text="🚚" style="-fx-font-size: 44px;"/>
                <Label text="Livraisons"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Gérer les livraisons"
                       style="-fx-font-size: 13px; -fx-text-fill: #999;"/>
            </VBox>

        </HBox>
    </VBox>
</VBox>
