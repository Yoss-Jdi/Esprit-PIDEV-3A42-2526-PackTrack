<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestioncolis.controllers.ListeColisController"
      spacing="0"
      prefWidth="1280" prefHeight="760" minWidth="1024" minHeight="700"
      style="-fx-background-color: #f4f4f4;">

    <!-- NAVBAR SIMPLIFIÉ -->
    <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="20" prefHeight="60"
          style="-fx-background-color: white; -fx-padding: 0 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
        <Button text="🏠 Retour" onAction="#retourDashboard"
                style="-fx-background-color: #f0f0f0; -fx-border-color: #ccc;
                       -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 8 16; -fx-font-weight: bold;"/>
        <Label text="📦 Colis"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAjouter" text="➕ Ajouter un colis" onAction="#ouvrirAjouter"
                style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-font-size: 13px;
                       -fx-cursor: hand; -fx-padding: 10 22; -fx-font-weight: bold;"/>
    </HBox>

    <!-- CONTENU SCROLLABLE -->
    <VBox VBox.vgrow="ALWAYS" spacing="12" style="-fx-padding: 28 36;">

        <!-- Barre outils : recherche + filtre statut + tri -->
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                     -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 16;">

            <TextField fx:id="tfRecherche"
                       promptText="🔍  Rechercher (description, adresse…)"
                       HBox.hgrow="ALWAYS"
                       style="-fx-pref-height: 36px; -fx-font-size: 13px;
                              -fx-border-color: #ddd; -fx-border-radius: 6;
                              -fx-background-radius: 6; -fx-padding: 0 12;"/>

            <Separator orientation="VERTICAL"/>

            <Label text="Statut :"
                   style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
            <ComboBox fx:id="cbFiltreStatut"
                      style="-fx-pref-height: 36px; -fx-font-size: 12px; -fx-pref-width: 155px;"/>

            <Separator orientation="VERTICAL"/>

            <Label text="Trier :"
                   style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
            <ComboBox fx:id="cbTri"
                      style="-fx-pref-height: 36px; -fx-font-size: 12px; -fx-pref-width: 175px;"/>
        </HBox>

        <!-- Message -->
        <Label fx:id="lblMessage" text="" style="-fx-font-size: 13px;" maxWidth="Infinity"/>

        <!-- Tableau -->
        <TableView fx:id="tableColis" VBox.vgrow="ALWAYS" maxWidth="Infinity"
                   style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                          -fx-border-radius: 10; -fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="colDescription" text="Description"    prefWidth="230" minWidth="150"/>
                <TableColumn fx:id="colDepart"      text="📍 Départ"      prefWidth="175" minWidth="110"/>
                <TableColumn fx:id="colDestination" text="🏁 Destination" prefWidth="175" minWidth="110"/>
                <TableColumn fx:id="colPoids"       text="Poids"          prefWidth="80"  minWidth="60"/>
                <TableColumn fx:id="colStatut"      text="Statut"         prefWidth="130" minWidth="100"/>
                <TableColumn fx:id="colMontant"     text="Montant"        prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="colActions"     text="Actions"        prefWidth="210" minWidth="190"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun colis trouvé."
                       style="-fx-text-fill: #aaa; -fx-font-size: 14px;"/>
            </placeholder>
        </TableView>

    </VBox>

</VBox>
