<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17.0.2-ea"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gestioncolis.controllers.chatbot"

           style="
                -fx-background-color:
                    linear-gradient(to bottom right, #eef2ff, #f8fafc);

                -fx-font-family: 'Segoe UI';
           ">

    <children>

        <!-- MAIN CHAT CARD -->
        <VBox prefHeight="620"
              prefWidth="340"

              style="
                    -fx-background-color: white;

                    -fx-background-radius: 22;

                    -fx-effect:
                        dropshadow(
                            gaussian,
                            rgba(15,23,42,0.15),
                            25,
                            0.2,
                            0,
                            8
                        );
              ">

            <!-- HEADER -->
            <VBox spacing="10"

                  style="
                        -fx-background-color:
                            linear-gradient(to right, #4f46e5, #7c3aed);

                        -fx-background-radius: 22 22 16 16;

                        -fx-padding: 16;
                  ">

                <HBox alignment="CENTER_LEFT" spacing="10">

                    <StackPane minWidth="40"
                               minHeight="40"

                               style="
                                    -fx-background-color: white;
                                    -fx-background-radius: 12;
                               ">

                        <Label text="AI"

                               style="
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #4f46e5;
                               "/>

                    </StackPane>

                    <VBox spacing="2">

                        <Label text="Assistant"

                               style="
                                    -fx-font-size: 12px;
                                    -fx-text-fill: rgba(255,255,255,0.75);
                               "/>

                        <Label text="Rayen AI"

                               style="
                                    -fx-font-size: 16px;
                                    -fx-font-weight: bold;
                                    -fx-text-fill: white;
                               "/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="×"
                            onAction="#handleClose"

                            style="
                                -fx-background-color: rgba(255,255,255,0.15);

                                -fx-text-fill: white;

                                -fx-font-weight: bold;

                                -fx-background-radius: 10;

                                -fx-padding: 6 10;

                                -fx-cursor: hand;
                            "/>

                </HBox>

                <Label fx:id="assistantStatusLabel"
                       text="Assistant local Ollama"

                       style="
                            -fx-font-size: 12px;
                            -fx-text-fill: rgba(255,255,255,0.80);
                       "/>

            </VBox>

            <!-- CHAT BODY -->
            <VBox spacing="12"
                  VBox.vgrow="ALWAYS"

                  style="-fx-padding: 14;">

                <ScrollPane fx:id="messagesScrollPane"
                            fitToWidth="true"
                            hbarPolicy="NEVER"

                            style="
                                -fx-background-color: transparent;
                                -fx-border-color: transparent;
                            "

                            VBox.vgrow="ALWAYS">

                    <content>

                        <VBox fx:id="messagesBox"
                              spacing="10"

                              style="
                                    -fx-padding: 6;
                              "/>

                    </content>

                </ScrollPane>

                <!-- QUICK ACTIONS -->
                <FlowPane hgap="8"
                          vgap="8">

                    <Button text="Véhicule"
                            onAction="#handleQuickVehicule"

                            style="
                                -fx-background-color: #eef2ff;

                                -fx-text-fill: #4f46e5;

                                -fx-background-radius: 14;

                                -fx-padding: 8 12;

                                -fx-font-size: 12px;

                                -fx-cursor: hand;
                            "/>

                    <Button text="Technicien"
                            onAction="#handleQuickTechnicien"

                            style="
                                -fx-background-color: #eef2ff;

                                -fx-text-fill: #4f46e5;

                                -fx-background-radius: 14;

                                -fx-padding: 8 12;

                                -fx-font-size: 12px;

                                -fx-cursor: hand;
                            "/>

                    <Button text="Stats"
                            onAction="#handleQuickStats"

                            style="
                                -fx-background-color: #eef2ff;

                                -fx-text-fill: #4f46e5;

                                -fx-background-radius: 14;

                                -fx-padding: 8 12;

                                -fx-font-size: 12px;

                                -fx-cursor: hand;
                            "/>

                    <Button text="Docs"
                            onAction="#handleQuickDocuments"

                            style="
                                -fx-background-color: #eef2ff;

                                -fx-text-fill: #4f46e5;

                                -fx-background-radius: 14;

                                -fx-padding: 8 12;

                                -fx-font-size: 12px;

                                -fx-cursor: hand;
                            "/>

                </FlowPane>

            </VBox>

            <!-- FOOTER -->
            <VBox spacing="8"

                  style="
                        -fx-padding: 12 14;
                  ">

                <Separator/>

                <HBox spacing="8">

                    <TextField fx:id="messageField"
                               onAction="#handleSend"
                               promptText="Écrire un message..."

                               HBox.hgrow="ALWAYS"

                               style="
                                    -fx-background-color: #f8fafc;

                                    -fx-border-color: #dbe4f0;

                                    -fx-border-radius: 14;
                                    -fx-background-radius: 14;

                                    -fx-padding: 10 12;
                               "/>

                    <Button fx:id="sendButton"
                            text="→"
                            onAction="#handleSend"

                            style="
                                -fx-background-color:
                                    linear-gradient(to right, #4f46e5, #7c3aed);

                                -fx-text-fill: white;

                                -fx-font-weight: bold;

                                -fx-background-radius: 14;

                                -fx-padding: 10 14;

                                -fx-cursor: hand;
                            "/>

                </HBox>

                <HBox alignment="CENTER" spacing="4">

                    <Label text="POWERED BY"
                           style="
                                -fx-font-size: 10px;
                                -fx-text-fill: #94a3b8;
                           "/>

                    <Label text="OLLAMA"
                           style="
                                -fx-font-size: 10px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #4f46e5;
                           "/>

                </HBox>

            </VBox>

        </VBox>

    </children>

</StackPane>