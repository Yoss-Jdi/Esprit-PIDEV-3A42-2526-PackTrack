<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestioncolis.controllers.modifyContoller"

            style="
                -fx-background-color:
                    linear-gradient(to bottom right, #f8fafc, #eef2ff);

                -fx-font-family: 'Segoe UI';
            ">

    <center>

        <VBox spacing="18"
              alignment="TOP_CENTER">

            <padding>
                <Insets top="22"
                        right="24"
                        bottom="22"
                        left="24"/>
            </padding>

            <!-- HEADER -->
            <VBox spacing="6"

                  maxWidth="760"

                  style="
                    -fx-background-color:
                        linear-gradient(to right, #4f46e5, #7c3aed);

                    -fx-background-radius: 20;

                    -fx-padding: 20;

                    -fx-effect:
                        dropshadow(
                            gaussian,
                            rgba(79,70,229,0.20),
                            18,
                            0.2,
                            0,
                            4
                        );
                  ">

                <Label fx:id="formTitleLabel"
                       text="Modifier un véhicule"

                       style="
                            -fx-font-size: 26px;
                            -fx-font-weight: bold;
                            -fx-text-fill: white;
                       "/>

                <Label text="Mise à jour des informations du véhicule sélectionné."

                       wrapText="true"

                       style="
                            -fx-font-size: 13px;

                            -fx-text-fill:
                                rgba(255,255,255,0.82);
                       "/>

            </VBox>

            <!-- FORM CARD -->
            <GridPane hgap="18"
                      vgap="16"

                      maxWidth="760"

                      style="
                        -fx-background-color: white;

                        -fx-background-radius: 22;
                        -fx-border-radius: 22;

                        -fx-padding: 28;

                        -fx-effect:
                            dropshadow(
                                gaussian,
                                rgba(15,23,42,0.10),
                                20,
                                0.12,
                                0,
                                5
                            );
                      ">

                <!-- MATRICULE -->
                <Label text="Matricule"

                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="matriculeField"
                           promptText="Ex: 123TN4567"

                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 14;
                                -fx-background-radius: 14;

                                -fx-padding: 12 14;

                                -fx-font-size: 14px;

                                -fx-pref-height: 42;
                           "/>

                <!-- MARQUE -->
                <Label text="Marque"

                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="marqueField"

                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 14;
                                -fx-background-radius: 14;

                                -fx-padding: 12 14;

                                -fx-font-size: 14px;
                           "/>

                <!-- MODELE -->
                <Label text="Modèle"

                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="modeleField"

                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 14;
                                -fx-background-radius: 14;

                                -fx-padding: 12 14;

                                -fx-font-size: 14px;
                           "/>

                <!-- COULEUR -->
                <Label text="Couleur"

                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="couleurField"

                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 14;
                                -fx-background-radius: 14;

                                -fx-padding: 12 14;

                                -fx-font-size: 14px;
                           "/>

                <!-- PRIX -->
                <Label text="Prix location"

                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="prixLocationField"

                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 14;
                                -fx-background-radius: 14;

                                -fx-padding: 12 14;

                                -fx-font-size: 14px;
                           "/>

                <!-- DISPONIBILITE -->
                <Label text="Disponibilité"

                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <CheckBox fx:id="disponibleCheckBox"
                          text="Véhicule disponible"

                          GridPane.columnIndex="1"
                          GridPane.rowIndex="5"

                          style="
                                -fx-font-size: 14px;
                                -fx-text-fill: #475569;
                          "/>

            </GridPane>

            <!-- FEEDBACK -->
            <Label fx:id="feedbackLabel"
                   wrapText="true"

                   maxWidth="760"

                   style="
                        -fx-background-color: #ecfeff;

                        -fx-text-fill: #0f766e;

                        -fx-padding: 12 14;

                        -fx-background-radius: 14;

                        -fx-border-color: #99f6e4;
                        -fx-border-radius: 14;

                        -fx-font-size: 13px;
                   "/>

            <!-- BUTTONS -->
            <HBox spacing="12"
                  maxWidth="760">

                <Button text="Mettre à jour"
                        onAction="#handleUpdate"

                        style="
                            -fx-background-color:
                                linear-gradient(
                                    to right,
                                    #4f46e5,
                                    #7c3aed
                                );

                            -fx-text-fill: white;

                            -fx-font-size: 14px;
                            -fx-font-weight: bold;

                            -fx-background-radius: 14;

                            -fx-padding: 12 28;

                            -fx-cursor: hand;
                        "/>

                <Button text="Retour"
                        onAction="#handleBack"

                        style="
                            -fx-background-color: white;

                            -fx-border-color: #cbd5e1;

                            -fx-border-radius: 14;
                            -fx-background-radius: 14;

                            -fx-text-fill: #334155;

                            -fx-font-size: 14px;
                            -fx-font-weight: bold;

                            -fx-padding: 12 24;

                            -fx-cursor: hand;
                        "/>

            </HBox>

        </VBox>

    </center>

</BorderPane>