<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestioncolis.controllers.addContoller"
            style="
                -fx-background-color:
                    linear-gradient(to bottom right, #eef2ff, #f8fafc);
                -fx-font-family: 'Segoe UI';
            ">

    <center>
        <BorderPane>

            <!-- HEADER -->


            <!-- CONTENT -->
            <center>

                <VBox spacing="20.0"
                      alignment="TOP_CENTER">

                    <padding>
                        <Insets bottom="30.0"
                                left="30.0"
                                right="30.0"
                                top="30.0"/>
                    </padding>

                    <!-- CARD -->
                    <GridPane hgap="18.0"
                              vgap="16.0"
                              maxWidth="760"
                              style="
                                -fx-background-color: white;

                                -fx-background-radius: 22;
                                -fx-border-radius: 22;

                                -fx-effect:
                                    dropshadow(
                                        gaussian,
                                        rgba(15,23,42,0.12),
                                        25,
                                        0.15,
                                        0,
                                        8
                                    );
                              ">

                        <padding>
                            <Insets bottom="28.0"
                                    left="28.0"
                                    right="28.0"
                                    top="28.0"/>
                        </padding>

                        <!-- MATRICULE -->
                        <Label text="Matricule"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"
                               style="
                                    -fx-font-size: 14px;
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #334155;
                               "/>

                        <TextField fx:id="matriculeField"
                                   promptText="Ex: 123TN4567"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"
                                   style="
                                        -fx-background-color: #f8fafc;
                                        -fx-border-color: #dbe4f0;

                                        -fx-border-radius: 14;
                                        -fx-background-radius: 14;

                                        -fx-padding: 12 14;

                                        -fx-font-size: 14px;

                                        -fx-pref-height: 42;
                                   "/>

                        <!-- MARQUE -->
                        <Label text="Marque"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1"
                               style="
                                    -fx-font-size: 14px;
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #334155;
                               "/>

                        <TextField fx:id="marqueField"
                                   promptText="Ex: Renault"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"
                                   style="
                                        -fx-background-color: #f8fafc;
                                        -fx-border-color: #dbe4f0;

                                        -fx-border-radius: 14;
                                        -fx-background-radius: 14;

                                        -fx-padding: 12 14;

                                        -fx-font-size: 14px;
                                   "/>

                        <!-- MODELE -->
                        <Label text="Modèle"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2"
                               style="
                                    -fx-font-size: 14px;
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #334155;
                               "/>

                        <TextField fx:id="modeleField"
                                   promptText="Ex: Clio 5"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"
                                   style="
                                        -fx-background-color: #f8fafc;
                                        -fx-border-color: #dbe4f0;

                                        -fx-border-radius: 14;
                                        -fx-background-radius: 14;

                                        -fx-padding: 12 14;

                                        -fx-font-size: 14px;
                                   "/>

                        <!-- COULEUR -->
                        <Label text="Couleur"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3"
                               style="
                                    -fx-font-size: 14px;
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #334155;
                               "/>

                        <TextField fx:id="couleurField"
                                   promptText="Ex: Noir"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3"
                                   style="
                                        -fx-background-color: #f8fafc;
                                        -fx-border-color: #dbe4f0;

                                        -fx-border-radius: 14;
                                        -fx-background-radius: 14;

                                        -fx-padding: 12 14;

                                        -fx-font-size: 14px;
                                   "/>

                        <!-- PRIX -->
                        <Label text="Prix location"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="4"
                               style="
                                    -fx-font-size: 14px;
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #334155;
                               "/>

                        <TextField fx:id="prixLocationField"
                                   promptText="Ex: 120.5"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="4"
                                   style="
                                        -fx-background-color: #f8fafc;
                                        -fx-border-color: #dbe4f0;

                                        -fx-border-radius: 14;
                                        -fx-background-radius: 14;

                                        -fx-padding: 12 14;

                                        -fx-font-size: 14px;
                                   "/>

                        <!-- EMAIL -->
                        <Label text="Email notification"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="5"
                               style="
                                    -fx-font-size: 14px;
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #334155;
                               "/>

                        <TextField fx:id="notificationEmailField"
                                   promptText="Ex: client@rayen.tn"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="5"
                                   style="
                                        -fx-background-color: #f8fafc;
                                        -fx-border-color: #dbe4f0;

                                        -fx-border-radius: 14;
                                        -fx-background-radius: 14;

                                        -fx-padding: 12 14;

                                        -fx-font-size: 14px;
                                   "/>

                        <!-- CHECKBOX -->
                        <Label text="Disponibilité"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="6"
                               style="
                                    -fx-font-size: 14px;
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #334155;
                               "/>

                        <CheckBox fx:id="disponibleCheckBox"
                                  text="Véhicule disponible"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="6"
                                  style="
                                        -fx-font-size: 14px;
                                        -fx-text-fill: #475569;
                                  "/>

                    </GridPane>

                    <!-- FEEDBACK -->
                    <Label fx:id="feedbackLabel"
                           wrapText="true"
                           style="
                                -fx-background-color: #ecfeff;
                                -fx-text-fill: #0f766e;

                                -fx-padding: 12;

                                -fx-background-radius: 12;

                                -fx-border-color: #99f6e4;
                                -fx-border-radius: 12;
                           "/>

                    <!-- BUTTONS -->
                    <HBox spacing="14">

                        <Button text="Enregistrer"
                                onAction="#handleSave"
                                style="
                                    -fx-background-color:
                                        linear-gradient(to right, #4f46e5, #7c3aed);

                                    -fx-text-fill: white;

                                    -fx-font-size: 14px;
                                    -fx-font-weight: bold;

                                    -fx-background-radius: 14;

                                    -fx-padding: 12 28;

                                    -fx-cursor: hand;
                                "/>

                        <Button text="Retour"
                                onAction="#handleBack"
                                style="
                                    -fx-background-color: white;

                                    -fx-border-color: #cbd5e1;

                                    -fx-border-radius: 14;
                                    -fx-background-radius: 14;

                                    -fx-text-fill: #334155;

                                    -fx-font-size: 14px;
                                    -fx-font-weight: bold;

                                    -fx-padding: 12 24;

                                    -fx-cursor: hand;
                                "/>

                    </HBox>

                </VBox>

            </center>

        </BorderPane>
    </center>

</BorderPane>