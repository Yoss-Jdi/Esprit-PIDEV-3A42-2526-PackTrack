<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestioncolis.controllers.displaytechnicien"
            styleClass="page">
    <center>
        <BorderPane>
            <top>
                <VBox spacing="16.0" styleClass="page-header">
                    <padding>
                        <Insets bottom="18.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                    <VBox spacing="6.0">
                        <Label text="Gestion des techniciens" styleClass="title-label" />
                        <Label text="CRUD des techniciens avec affectation de plusieurs véhicules par technicien." styleClass="subtitle-label" />
                    </VBox>
                    <HBox spacing="12.0">
                        <Button text="Ajouter"      onAction="#handleAdd"         styleClass="primary-button" />
                        <Button text="Modifier"     onAction="#handleModify"      styleClass="secondary-button" />
                        <Button text="Supprimer"    onAction="#handleDelete"      styleClass="danger-button" />
                        <Button text="Générer PDF"  onAction="#handleGeneratePdf" styleClass="secondary-button" />
                        <Button text="Actualiser"   onAction="#handleRefresh"     styleClass="secondary-button" />
                        <Button text="Statistiques" onAction="#handleStats"       styleClass="secondary-button" />
                    </HBox>
                </VBox>
            </top>
            <center>
                <VBox spacing="16.0">
                    <padding>
                        <Insets bottom="18.0" left="24.0" right="24.0" top="0.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="search-bar-container">
                        <Label text="Recherche" styleClass="search-caption" />
                        <TextField fx:id="searchField"
                                   promptText="Rechercher par nom, spécialité, téléphone, email ou véhicule..."
                                   styleClass="search-input"
                                   HBox.hgrow="ALWAYS" />
                        <Button text="Effacer" onAction="#handleClearSearch" styleClass="secondary-button" />
                    </HBox>
                    <TableView fx:id="technicienTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="idColumn"             prefWidth="70.0"  text="ID" />
                            <TableColumn fx:id="nomCompletColumn"     prefWidth="170.0" text="Nom complet" />
                            <TableColumn fx:id="specialiteColumn"     prefWidth="140.0" text="Spécialité" />
                            <TableColumn fx:id="telephoneColumn"      prefWidth="130.0" text="Téléphone" />
                            <TableColumn fx:id="emailColumn"          prefWidth="210.0" text="Email" />
                            <TableColumn fx:id="nombreVehiculesColumn" prefWidth="120.0" text="Nb véhicules" />
                            <TableColumn fx:id="vehiculesColumn"      prefWidth="250.0" text="Véhicules assignés" />
                        </columns>
                    </TableView>
                </VBox>
            </center>
            <bottom>
                <HBox styleClass="footer-bar">
                    <padding>
                        <Insets bottom="18.0" left="24.0" right="24.0" top="0.0" />
                    </padding>
                    <Label fx:id="infoLabel" styleClass="info-label" />
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
