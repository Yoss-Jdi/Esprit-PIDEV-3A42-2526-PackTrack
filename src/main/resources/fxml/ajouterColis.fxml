<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestioncolis.controllers.AjouterColisController"
      spacing="20"
      maxWidth="Infinity" maxHeight="Infinity"
      alignment="TOP_CENTER"
      style="-fx-background-color: #f4f4f4; -fx-padding: 32 60;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="14" maxWidth="860">
        <Button text="←" onAction="#retourListe"
                style="-fx-background-color: transparent; -fx-border-color: #ccc;
                       -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 6 14;">
            <tooltip><Tooltip text="Retour à la liste"/></tooltip>
        </Button>
        <Label text="Nouveau colis"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    </HBox>

    <!-- Formulaire centré et élargi -->
    <VBox spacing="18"
          maxWidth="860"
          style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                 -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 36;">

        <!-- Description + Articles -->
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Description"
                       style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <TextField fx:id="tfDescription" promptText="Min. 5 caractères"
                           style="-fx-pref-height: 40px; -fx-border-color: #ddd;
                                  -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Articles"
                       style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <TextField fx:id="tfArticles" promptText="Liste des articles"
                           style="-fx-pref-height: 40px; -fx-border-color: #ddd;
                                  -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>
        </HBox>

        <!-- Adresses -->
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="📍 Adresse de départ"
                       style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <TextField fx:id="tfDepart" promptText="Ville / adresse de départ"
                           style="-fx-pref-height: 40px; -fx-border-color: #ddd;
                                  -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="🏁 Adresse de destination"
                       style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <TextField fx:id="tfDestination" promptText="Ville / adresse de destination"
                           style="-fx-pref-height: 40px; -fx-border-color: #ddd;
                                  -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>
        </HBox>

        <!-- Poids & Dimensions -->
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="⚖️ Poids (kg)"
                       style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <TextField fx:id="tfPoids" promptText="Ex : 2.5"
                           style="-fx-pref-height: 40px; -fx-border-color: #ddd;
                                  -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="📐 Dimensions"
                       style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <TextField fx:id="tfDimensions" promptText="Ex : 30x20x10 cm"
                           style="-fx-pref-height: 40px; -fx-border-color: #ddd;
                                  -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12; -fx-font-size: 13px;"/>
            </VBox>
        </HBox>

        <!-- Destinataire -->
        <VBox spacing="6">
            <Label text="👤 Destinataire"
                   style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
            <ComboBox fx:id="cbDestinataire"
                      promptText="Sélectionner un client..."
                      maxWidth="Infinity"
                      style="-fx-pref-height: 40px; -fx-font-size: 13px;
                             -fx-border-color: #ddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
            <Label text="ℹ️  L'expéditeur est automatiquement votre compte connecté."
                   style="-fx-font-size: 12px; -fx-text-fill: #aaa; -fx-font-style: italic;"/>
        </VBox>

        <!-- Séparateur -->
        <Separator/>

        <!-- Erreur -->
        <Label fx:id="lblErreur" text=""
               style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-wrap-text: true;"
               maxWidth="Infinity"/>

        <!-- Bouton enregistrer -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="💾  Enregistrer le colis" onAction="#enregistrer"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-cursor: hand; -fx-padding: 12 32;">
                <tooltip><Tooltip text="Enregistrer le colis"/></tooltip>
            </Button>
            <Button text="Annuler" onAction="#retourListe"
                    style="-fx-background-color: transparent; -fx-border-color: #ccc;
                           -fx-border-radius: 8; -fx-background-radius: 8;
                           -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 12 24;"/>
        </HBox>

    </VBox>
</VBox>
