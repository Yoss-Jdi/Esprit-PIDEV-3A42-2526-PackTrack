<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestioncolis.controllers.ListeLivraisonsController"
      spacing="16"
      maxWidth="Infinity" maxHeight="Infinity"
      style="-fx-background-color: #f4f4f4; -fx-padding: 28 36;">

    <HBox alignment="CENTER_LEFT" spacing="14" maxWidth="Infinity">
        <Button text="🏠" onAction="#retourDashboard"
                style="-fx-background-color: transparent; -fx-border-color: #ccc;
                       -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 6 12;">
            <tooltip><Tooltip text="Tableau de bord"/></tooltip>
        </Button>
        <Label text="🚚 Livraisons"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Prendre en charge" onAction="#ouvrirAjouter"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-font-size: 13px;
                       -fx-cursor: hand; -fx-padding: 10 22;">
            <tooltip><Tooltip text="Prendre un colis en charge"/></tooltip>
        </Button>
    </HBox>

    <Label fx:id="lblMessage" text="" style="-fx-font-size: 13px;" maxWidth="Infinity"/>

    <TableView fx:id="tableLivraisons" VBox.vgrow="ALWAYS" maxWidth="Infinity"
               style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                      -fx-border-radius: 10; -fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colDescriptionColis" text="Colis"            prefWidth="240" minWidth="160"/>
            <TableColumn fx:id="colNomLivreur"       text="Livreur"          prefWidth="160" minWidth="120"/>
            <TableColumn fx:id="colStatut"           text="Statut"           prefWidth="120" minWidth="90"/>
            <TableColumn fx:id="colDistance"         text="Distance"         prefWidth="100" minWidth="70"/>
            <TableColumn fx:id="colDuree"            text="Durée estimée"    prefWidth="120" minWidth="90"/>
            <TableColumn fx:id="colTotal"            text="Total (DT)"       prefWidth="110" minWidth="80"/>
            <TableColumn fx:id="colDateDebut"        text="Prise en charge"  prefWidth="160" minWidth="130"/>
            <TableColumn fx:id="colActions"          text="Actions"          prefWidth="160" minWidth="140"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Aucune livraison pour le moment."
                   style="-fx-text-fill: #aaa; -fx-font-size: 14px;"/>
        </placeholder>
    </TableView>

</VBox>
