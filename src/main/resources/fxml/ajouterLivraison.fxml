<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestioncolis.controllers.AjouterLivraisonController"
      spacing="16"
      maxWidth="Infinity" maxHeight="Infinity"
      style="-fx-background-color: #f4f4f4; -fx-padding: 28 36;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="14" maxWidth="Infinity">
        <Button text="←" onAction="#retourListe"
                style="-fx-background-color: transparent; -fx-border-color: #ccc;
                       -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 6 14;">
            <tooltip><Tooltip text="Retour"/></tooltip>
        </Button>
        <Label text="🚚 Prendre un colis en charge"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnLocalisation" text="📍 Ma position" onAction="#definirLocalisation"
                style="-fx-background-color: #3498db; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-font-size: 13px;
                       -fx-cursor: hand; -fx-padding: 10 20;">
            <tooltip><Tooltip text="Définir ma position pour trier les colis"/></tooltip>
        </Button>
    </HBox>

    <!-- Bandeau livreur + bouton action -->
    <HBox alignment="CENTER_LEFT" spacing="16" maxWidth="Infinity"
          style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                 -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 16 24;">
        <Label text="👤 Livreur :" style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
        <Label fx:id="lblLivreur"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEnregistrer" text="🚚  Prendre en charge" onAction="#enregistrer"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-cursor: hand; -fx-padding: 10 28;">
            <tooltip><Tooltip text="Prendre ce colis en charge"/></tooltip>
        </Button>
    </HBox>

    <!-- Résumé colis sélectionné -->
    <Label fx:id="lblSelectionInfo" text=""
           style="-fx-font-size: 13px; -fx-text-fill: #2980b9;
                  -fx-background-color: #eaf4fb; -fx-padding: 8 16;
                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-wrap-text: true;"
           maxWidth="Infinity"/>

    <!-- Bandeau IA -->
    <VBox spacing="6" style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0;
                             -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16;">
        <Label fx:id="lblIaStatut" text="Sélectionnez un colis pour lancer l'analyse IA"
               style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
        <Label fx:id="lblIaDistance" text=""
               style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
        <Label fx:id="lblIaDuree" text=""
               style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
    </VBox>

    <!-- Erreur -->
    <Label fx:id="lblErreur" text=""
           style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-wrap-text: true;"
           maxWidth="Infinity"/>

    <!-- Tableau colis disponibles -->
    <VBox spacing="8" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        <Label text="📦 Colis disponibles — triés par proximité (cliquez pour voir les détails)"
               style="-fx-font-size: 13px; -fx-text-fill: #888;"/>

        <TableView fx:id="tableColisDisponibles" VBox.vgrow="ALWAYS" maxWidth="Infinity"
                   style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                          -fx-border-radius: 10; -fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="colCProximite" text="📍 Distance" prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="colCDesc"      text="Description"  prefWidth="240" minWidth="160"/>
                <TableColumn fx:id="colCDep"       text="📍 Départ"    prefWidth="200" minWidth="130"/>
                <TableColumn fx:id="colCDest"      text="🏁 Destination" prefWidth="200" minWidth="130"/>
                <TableColumn fx:id="colCPoid"      text="Poids"        prefWidth="90"  minWidth="70"/>
                <TableColumn fx:id="colCMontant"   text="Montant"      prefWidth="120" minWidth="90"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun colis disponible pour le moment."
                       style="-fx-text-fill: #aaa; -fx-font-size: 14px;"/>
            </placeholder>
        </TableView>
    </VBox>

</VBox>