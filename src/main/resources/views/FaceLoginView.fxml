<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Text?>

<StackPane
        prefHeight="700"
        prefWidth="1100"
        stylesheets="@../css/auth.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.gestioncolis.controllers.FaceLoginController">

    <!-- ═══ Animated Background ═══ -->
    <Pane prefHeight="700" prefWidth="1100" styleClass="root-bg" />

    <!-- Background blobs -->
    <Pane mouseTransparent="true" prefHeight="700" prefWidth="1100">
        <Circle fx:id="blob1" centerX="150" centerY="120" radius="300" styleClass="bg-blob,blob-1" />
        <Circle fx:id="blob2" centerX="980" centerY="600" radius="240" styleClass="bg-blob,blob-2" />
        <Circle fx:id="blob3" centerX="920" centerY="100" radius="150" styleClass="bg-blob,blob-3" />
        <Circle fx:id="blob4" centerX="200" centerY="620" radius="120" styleClass="bg-blob,blob-4" />
        <Circle fx:id="blob5" centerX="550" centerY="370" radius="200" styleClass="bg-blob,blob-5" opacity="0.12" />
    </Pane>

    <!-- ═══ Main Card ═══ -->
    <HBox fx:id="mainCard" alignment="CENTER" maxHeight="640" maxWidth="1000"
          prefHeight="640" prefWidth="1000" styleClass="face-card">

        <!-- ══════════════════════════════════════════
             LEFT PANEL — Brand + Steps
             ══════════════════════════════════════════ -->
        <StackPane prefHeight="640" prefWidth="380" styleClass="face-left-panel">
            <Pane styleClass="glass-panel" />
            <Circle radius="260" styleClass="panel-deco-circle,deco-big"
                    translateX="-90" translateY="-90" StackPane.alignment="TOP_LEFT" />
            <Circle radius="150" styleClass="panel-deco-circle,deco-small"
                    translateX="70" translateY="70" StackPane.alignment="BOTTOM_RIGHT" />

            <VBox alignment="CENTER" spacing="32" StackPane.alignment="CENTER">

                <!-- Logo -->
                <StackPane prefHeight="100" prefWidth="100" styleClass="logo-container">
                    <Circle radius="50" styleClass="logo-outer" />
                    <Circle radius="36" styleClass="logo-inner" />
                    <Circle radius="28" styleClass="logo-glow" />
                    <Text styleClass="logo-text" text="TP" />
                </StackPane>

                <Text text="TrackPack" styleClass="brand-name" />

                <VBox alignment="CENTER" spacing="10">
                    <Text styleClass="face-panel-title" text="Reconnaissance" />
                    <Text styleClass="face-panel-title" text="Faciale" />
                    <Text styleClass="face-panel-subtitle"
                          text="Connectez-vous en toute&#10;sécurité grâce à votre&#10;visage." textAlignment="CENTER" />
                </VBox>

                <!-- Steps indicator -->
                <VBox fx:id="stepsBox" alignment="CENTER_LEFT" spacing="16"
                      style="-fx-padding: 0 30 0 30;">

                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <StackPane fx:id="step1Circle" styleClass="step-circle,step-active" prefWidth="32" prefHeight="32">
                            <Text text="1" styleClass="step-number" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label fx:id="step1Label" text="Entrer l'email" styleClass="step-label-active" />
                            <Label text="Identifiez votre compte" styleClass="step-sublabel" />
                        </VBox>
                    </HBox>

                    <Pane prefWidth="2" prefHeight="20" styleClass="step-connector"
                          style="-fx-translate-x: 15;" />

                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <StackPane fx:id="step2Circle" styleClass="step-circle,step-inactive" prefWidth="32" prefHeight="32">
                            <Text text="2" styleClass="step-number" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label fx:id="step2Label" text="Scan du visage" styleClass="step-label-inactive" />
                            <Label text="Positionnez-vous face à la caméra" styleClass="step-sublabel" />
                        </VBox>
                    </HBox>

                    <Pane prefWidth="2" prefHeight="20" styleClass="step-connector"
                          style="-fx-translate-x: 15;" />

                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <StackPane fx:id="step3Circle" styleClass="step-circle,step-inactive" prefWidth="32" prefHeight="32">
                            <Text text="3" styleClass="step-number" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label fx:id="step3Label" text="Accès autorisé" styleClass="step-label-inactive" />
                            <Label text="Connexion sécurisée" styleClass="step-sublabel" />
                        </VBox>
                    </HBox>

                </VBox>

                <Button onAction="#handleBackToLogin" styleClass="face-back-btn"
                        text="← Connexion classique" />

            </VBox>
        </StackPane>

        <!-- ══════════════════════════════════════════
             RIGHT PANEL — Steps content
             ══════════════════════════════════════════ -->
        <StackPane fx:id="contentStack" prefHeight="640" prefWidth="620"
                   styleClass="face-right-panel">

            <!-- ─────────────────────────────────────
                 STEP 1 — Email input
                 ───────────────────────────────────── -->
            <VBox fx:id="emailStep" alignment="CENTER" spacing="32"
                  style="-fx-padding: 50 60 50 60;">

                <VBox alignment="CENTER" spacing="10">
                    <StackPane prefWidth="80" prefHeight="80" styleClass="step-icon-container">
                        <Text text="📧" styleClass="step-icon" />
                    </StackPane>
                    <Label text="Identification" styleClass="face-step-title" />
                    <Label text="Entrez votre adresse email pour commencer" styleClass="face-step-sub" />
                </VBox>

                <VBox spacing="10" prefWidth="420">
                    <Label styleClass="field-label" text="Adresse e-mail">
                        <graphic>
                            <Text text="📧" style="-fx-font-size: 12px;" />
                        </graphic>
                    </Label>
                    <TextField fx:id="emailField" promptText="votre@email.com"
                               styleClass="field-input,face-email-input" />
                    <Label fx:id="emailError" managed="false" styleClass="field-error" visible="false" />
                </VBox>

                <HBox styleClass="face-info-box" spacing="12" alignment="CENTER_LEFT"
                      prefWidth="420">
                    <Text text="ℹ️" style="-fx-font-size: 16px;" />
                    <Label text="Votre email sera utilisé pour trouver votre photo de profil et effectuer la comparaison biométrique."
                           styleClass="face-info-text" wrapText="true" HBox.hgrow="ALWAYS" />
                </HBox>

                <Button fx:id="btnStartScan" onAction="#handleStartScan"
                        prefWidth="420" styleClass="face-primary-btn"
                        text="Démarrer le scan biométrique  →" />

            </VBox>

            <!-- ─────────────────────────────────────
                 STEP 2 — Webcam + Face scan
                 ───────────────────────────────────── -->
            <VBox fx:id="scanStep" alignment="CENTER" spacing="20" opacity="0"
                  style="-fx-padding: 30 40 30 40;" visible="false">

                <!-- Status row -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="scan-status-dot">
                        <Circle fx:id="statusDot" radius="6" styleClass="scan-dot-active" />
                    </StackPane>
                    <Label fx:id="scanStatusLabel"
                           text="Caméra active — Positionnez votre visage"
                           styleClass="scan-status-text" />
                </HBox>

                <!-- Webcam container -->
                <StackPane prefWidth="480" prefHeight="360" styleClass="webcam-container">

                    <ImageView fx:id="webcamView" fitWidth="480" fitHeight="360"
                               preserveRatio="true" styleClass="webcam-feed" />

                    <Pane fx:id="webcamOverlay" styleClass="webcam-overlay"
                          prefWidth="480" prefHeight="360" visible="false" />

                    <!-- Biometric overlay (non-interactive) -->
                    <Pane mouseTransparent="true" prefWidth="480" prefHeight="360">

                        <!-- Scan frame corners -->
                        <Pane styleClass="scan-corner,corner-tl" layoutX="80"  layoutY="40"  prefWidth="50" prefHeight="50" />
                        <Pane styleClass="scan-corner,corner-tr" layoutX="350" layoutY="40"  prefWidth="50" prefHeight="50" />
                        <Pane styleClass="scan-corner,corner-bl" layoutX="80"  layoutY="270" prefWidth="50" prefHeight="50" />
                        <Pane styleClass="scan-corner,corner-br" layoutX="350" layoutY="270" prefWidth="50" prefHeight="50" />

                        <!-- Face oval guide -->
                        <Pane fx:id="faceOval" styleClass="face-oval"
                              layoutX="130" layoutY="20" prefWidth="220" prefHeight="280" />

                        <!-- Animated scan line -->
                        <Pane fx:id="scanLine" styleClass="scan-line"
                              layoutX="130" layoutY="20" prefWidth="220" prefHeight="3" />

                        <!-- Landmark dots -->
                        <Circle fx:id="dotEyeL"     centerX="185" centerY="120" radius="4" styleClass="biometric-dot" />
                        <Circle fx:id="dotEyeR"     centerX="295" centerY="120" radius="4" styleClass="biometric-dot" />
                        <Circle fx:id="dotNose"     centerX="240" centerY="185" radius="4" styleClass="biometric-dot" />
                        <Circle fx:id="dotMouthL"   centerX="200" centerY="235" radius="3" styleClass="biometric-dot" />
                        <Circle fx:id="dotMouthR"   centerX="280" centerY="235" radius="3" styleClass="biometric-dot" />
                        <Circle fx:id="dotChin"     centerX="240" centerY="280" radius="3" styleClass="biometric-dot" />
                        <Circle fx:id="dotForehead" centerX="240" centerY="60"  radius="3" styleClass="biometric-dot" />
                        <Circle fx:id="dotCheekL"   centerX="155" centerY="185" radius="3" styleClass="biometric-dot" />
                        <Circle fx:id="dotCheekR"   centerX="325" centerY="185" radius="3" styleClass="biometric-dot" />

                        <!-- Landmark connection lines -->
                        <Line fx:id="lineEyes"       startX="185" startY="120" endX="295" endY="120" styleClass="biometric-line" />
                        <Line fx:id="lineEyeLNose"   startX="185" startY="120" endX="240" endY="185" styleClass="biometric-line" />
                        <Line fx:id="lineEyeRNose"   startX="295" startY="120" endX="240" endY="185" styleClass="biometric-line" />
                        <Line fx:id="lineNoseMouthL" startX="240" startY="185" endX="200" endY="235" styleClass="biometric-line" />
                        <Line fx:id="lineNoseMouthR" startX="240" startY="185" endX="280" endY="235" styleClass="biometric-line" />
                        <Line fx:id="lineMouth"      startX="200" startY="235" endX="280" endY="235" styleClass="biometric-line" />
                        <Line fx:id="lineForeL"      startX="240" startY="60"  endX="185" endY="120" styleClass="biometric-line" />
                        <Line fx:id="lineForeR"      startX="240" startY="60"  endX="295" endY="120" styleClass="biometric-line" />

                        <!-- Match % badge -->
                        <StackPane layoutX="360" layoutY="10" prefWidth="110" prefHeight="36"
                                   styleClass="match-pct-badge">
                            <Label fx:id="matchPctLabel" text="—" styleClass="match-pct-text" />
                        </StackPane>

                    </Pane>

                    <!-- Loading spinner -->
                    <VBox fx:id="cameraLoadingBox" alignment="CENTER" spacing="12"
                          prefWidth="480" prefHeight="360" styleClass="camera-loading-box">
                        <StackPane prefWidth="60" prefHeight="60" styleClass="spinner-ring-container">
                            <Circle radius="28" styleClass="spinner-ring" />
                        </StackPane>
                        <Label text="Initialisation de la caméra…" styleClass="camera-loading-text" />
                    </VBox>

                </StackPane>

                <!-- Progress bar -->
                <!-- FIX: replaced CENTER_SPACE_BETWEEN with CENTER_LEFT + HBox.hgrow="ALWAYS" -->
                <VBox spacing="6" prefWidth="480">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Analyse biométrique" styleClass="progress-label" HBox.hgrow="ALWAYS" />
                        <Label fx:id="progressPctLabel" text="0%" styleClass="progress-pct" />
                    </HBox>
                    <StackPane prefHeight="8" prefWidth="480" styleClass="progress-track">
                        <Pane fx:id="progressFill" styleClass="progress-fill"
                              prefHeight="8" prefWidth="0" StackPane.alignment="CENTER_LEFT" />
                    </StackPane>
                </VBox>

                <!-- Action buttons -->
                <HBox alignment="CENTER" spacing="16">
                    <Button fx:id="btnCapture" onAction="#handleCapture"
                            styleClass="face-capture-btn" text="📸  Capturer &amp; Analyser" />
                    <Button onAction="#handleCancelScan" styleClass="face-cancel-btn"
                            text="✕  Annuler" />
                </HBox>

            </VBox>

            <!-- ─────────────────────────────────────
                 STEP 3 — Result
                 ───────────────────────────────────── -->
            <VBox fx:id="resultStep" alignment="CENTER" spacing="28" opacity="0"
                  style="-fx-padding: 50 60 50 60;" visible="false">

                <!-- Result icon -->
                <StackPane fx:id="resultIconContainer" prefWidth="120" prefHeight="120"
                           styleClass="result-icon-bg-success">
                    <Label fx:id="resultIcon" text="✓" styleClass="result-icon-text" />
                </StackPane>

                <!-- Titles -->
                <VBox alignment="CENTER" spacing="8">
                    <Label fx:id="resultTitle" text="Identité confirmée" styleClass="result-title-success" />
                    <Label fx:id="resultSubtitle" text="Bienvenue !" styleClass="result-subtitle" />
                </VBox>

                <!-- Match details card -->
                <!-- FIX: all CENTER_SPACE_BETWEEN replaced with CENTER_LEFT + HBox.hgrow="ALWAYS" on left label -->
                <VBox fx:id="matchDetailsCard" styleClass="match-card" spacing="14" prefWidth="420">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Taux de correspondance" styleClass="match-card-label" HBox.hgrow="ALWAYS" />
                        <Label fx:id="finalScoreLabel" text="—" styleClass="match-card-score" />
                    </HBox>

                    <Pane styleClass="match-card-divider" prefHeight="1" />

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Utilisateur détecté" styleClass="match-card-label" HBox.hgrow="ALWAYS" />
                        <Label fx:id="detectedUserLabel" text="—" styleClass="match-card-value" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Méthode" styleClass="match-card-label" HBox.hgrow="ALWAYS" />
                        <Label text="Analyse biométrique" styleClass="match-card-value" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Statut" styleClass="match-card-label" HBox.hgrow="ALWAYS" />
                        <Label fx:id="statusLabel" text="—" styleClass="match-card-status" />
                    </HBox>

                </VBox>

                <!-- Buttons -->
                <VBox spacing="12" prefWidth="420">
                    <Button fx:id="btnContinue" onAction="#handleContinue"
                            prefWidth="420" styleClass="face-primary-btn"
                            text="Accéder au tableau de bord  →" />
                    <Button onAction="#handleRetry" prefWidth="420"
                            styleClass="face-secondary-btn"
                            text="🔄  Réessayer" />
                </VBox>

            </VBox>

        </StackPane>
    </HBox>

</StackPane>
