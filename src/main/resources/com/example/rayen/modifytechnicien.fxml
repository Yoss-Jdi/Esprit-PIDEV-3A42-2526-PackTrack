<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestioncolis.controllers.modifytechnicien"

            style="
                -fx-background-color:
                    linear-gradient(to bottom right, #f8fafc, #eef2ff);

                -fx-font-family: 'Segoe UI';
            ">

    <center>

        <VBox spacing="16">

            <padding>
                <Insets top="18"
                        right="20"
                        bottom="18"
                        left="20"/>
            </padding>

            <!-- HEADER COMPACT -->
            <VBox spacing="6"

                  style="
                    -fx-background-color:
                        linear-gradient(to right, #4f46e5, #7c3aed);

                    -fx-background-radius: 18;

                    -fx-padding: 16;

                    -fx-effect:
                        dropshadow(
                            gaussian,
                            rgba(79,70,229,0.20),
                            16,
                            0.2,
                            0,
                            4
                        );
                  ">

                <Label fx:id="formTitleLabel"
                       text="Modifier un technicien"

                       style="
                            -fx-font-size: 24px;
                            -fx-font-weight: bold;
                            -fx-text-fill: white;
                       "/>

                <Label text="Mise à jour des informations et affectations"

                       wrapText="true"

                       style="
                            -fx-font-size: 13px;
                            -fx-text-fill: rgba(255,255,255,0.85);
                       "/>

            </VBox>

            <!-- FORM CARD -->
            <GridPane hgap="18"
                      vgap="16"

                      style="
                        -fx-background-color: white;

                        -fx-background-radius: 20;

                        -fx-padding: 24;

                        -fx-effect:
                            dropshadow(
                                gaussian,
                                rgba(15,23,42,0.10),
                                18,
                                0.12,
                                0,
                                4
                            );
                      ">

                <!-- NOM -->
                <Label text="Nom"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="nomField"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 12;
                                -fx-background-radius: 12;

                                -fx-padding: 10 14;

                                -fx-font-size: 14px;
                           "/>

                <!-- PRENOM -->
                <Label text="Prénom"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="prenomField"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 12;
                                -fx-background-radius: 12;

                                -fx-padding: 10 14;

                                -fx-font-size: 14px;
                           "/>

                <!-- SPECIALITE -->
                <Label text="Spécialité"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="specialiteField"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 12;
                                -fx-background-radius: 12;

                                -fx-padding: 10 14;

                                -fx-font-size: 14px;
                           "/>

                <!-- TELEPHONE -->
                <Label text="Téléphone"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="telephoneField"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 12;
                                -fx-background-radius: 12;

                                -fx-padding: 10 14;

                                -fx-font-size: 14px;
                           "/>

                <!-- EMAIL -->
                <Label text="Email"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <TextField fx:id="emailField"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"

                           style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 12;
                                -fx-background-radius: 12;

                                -fx-padding: 10 14;

                                -fx-font-size: 14px;
                           "/>

                <!-- VEHICULES -->
                <Label text="Véhicules"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"

                       style="
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <ListView fx:id="vehiculesListView"
                          prefHeight="170"

                          GridPane.columnIndex="1"
                          GridPane.rowIndex="5"

                          style="
                                -fx-background-color: #f8fafc;

                                -fx-border-color: #dbe4f0;

                                -fx-border-radius: 12;
                                -fx-background-radius: 12;
                          "/>

            </GridPane>

            <!-- FEEDBACK -->
            <Label fx:id="feedbackLabel"
                   wrapText="true"

                   style="
                        -fx-background-color: #ecfeff;

                        -fx-text-fill: #0f766e;

                        -fx-padding: 10 14;

                        -fx-background-radius: 12;

                        -fx-border-color: #99f6e4;
                        -fx-border-radius: 12;

                        -fx-font-size: 13px;
                   "/>

            <!-- BUTTONS -->
            <HBox spacing="12">

                <Button text="Mettre à jour"
                        onAction="#handleUpdate"

                        style="
                            -fx-background-color:
                                linear-gradient(to right, #4f46e5, #7c3aed);

                            -fx-text-fill: white;

                            -fx-font-weight: bold;

                            -fx-background-radius: 12;

                            -fx-padding: 10 22;

                            -fx-cursor: hand;
                        "/>

                <Button text="Retour"
                        onAction="#handleBack"

                        style="
                            -fx-background-color: white;

                            -fx-border-color: #cbd5e1;

                            -fx-border-radius: 12;
                            -fx-background-radius: 12;

                            -fx-text-fill: #334155;

                            -fx-font-weight: bold;

                            -fx-padding: 10 20;

                            -fx-cursor: hand;
                        "/>

            </HBox>

        </VBox>

    </center>

</BorderPane>