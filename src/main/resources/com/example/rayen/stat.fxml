<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestioncolis.controllers.stat"

            style="
                -fx-background-color:
                    linear-gradient(to bottom right, #f8fafc, #eef2ff);

                -fx-font-family: 'Segoe UI';
            ">

    <center>

        <VBox spacing="16">

            <padding>
                <Insets top="18"
                        right="20"
                        bottom="18"
                        left="20"/>
            </padding>

            <!-- HEADER COMPACT -->
            <VBox spacing="10"

                  style="
                    -fx-background-color:
                        linear-gradient(to right, #4f46e5, #7c3aed);

                    -fx-background-radius: 18;

                    -fx-padding: 16;

                    -fx-effect:
                        dropshadow(
                            gaussian,
                            rgba(79,70,229,0.20),
                            16,
                            0.2,
                            0,
                            4
                        );
                  ">

                <Label text="Statistiques des techniciens"

                       style="
                            -fx-font-size: 24px;
                            -fx-font-weight: bold;
                            -fx-text-fill: white;
                       "/>

                <Label text="Analyse de la charge des techniciens et affectations"

                       style="
                            -fx-font-size: 13px;
                            -fx-text-fill: rgba(255,255,255,0.85);
                       "/>

                <HBox spacing="10">

                    <Button text="Actualiser"
                            onAction="#handleRefresh"

                            style="
                                -fx-background-color:
                                    rgba(255,255,255,0.15);

                                -fx-text-fill: white;

                                -fx-border-color:
                                    rgba(255,255,255,0.25);

                                -fx-border-radius: 12;
                                -fx-background-radius: 12;

                                -fx-padding: 8 16;

                                -fx-font-weight: bold;

                                -fx-cursor: hand;
                            "/>

                    <Button text="Techniciens"
                            onAction="#handleGoTechniciens"

                            style="
                                -fx-background-color: white;

                                -fx-text-fill: #4f46e5;

                                -fx-font-weight: bold;

                                -fx-background-radius: 12;

                                -fx-padding: 8 16;

                                -fx-cursor: hand;
                            "/>

                </HBox>

            </VBox>

            <!-- KPI CARDS -->
            <HBox spacing="12">

                <VBox spacing="6"
                      HBox.hgrow="ALWAYS"

                      style="
                            -fx-background-color: white;

                            -fx-background-radius: 16;

                            -fx-padding: 16;

                            -fx-effect:
                                dropshadow(
                                    gaussian,
                                    rgba(15,23,42,0.08),
                                    14,
                                    0.12,
                                    0,
                                    4
                                );
                      ">

                    <Label fx:id="technicienCountLabel"
                           text="0"

                           style="
                                -fx-font-size: 24px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #4f46e5;
                           "/>

                    <Label text="Techniciens"
                           style="
                                -fx-font-size: 12px;
                                -fx-text-fill: #64748b;
                           "/>

                </VBox>

                <VBox spacing="6"
                      HBox.hgrow="ALWAYS"

                      style="
                            -fx-background-color: white;

                            -fx-background-radius: 16;

                            -fx-padding: 16;

                            -fx-effect:
                                dropshadow(
                                    gaussian,
                                    rgba(15,23,42,0.08),
                                    14,
                                    0.12,
                                    0,
                                    4
                                );
                      ">

                    <Label fx:id="assignedVehiculeCountLabel"
                           text="0"

                           style="
                                -fx-font-size: 24px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #7c3aed;
                           "/>

                    <Label text="Véhicules assignés"
                           style="
                                -fx-font-size: 12px;
                                -fx-text-fill: #64748b;
                           "/>

                </VBox>

                <VBox spacing="6"
                      HBox.hgrow="ALWAYS"

                      style="
                            -fx-background-color: white;

                            -fx-background-radius: 16;

                            -fx-padding: 16;

                            -fx-effect:
                                dropshadow(
                                    gaussian,
                                    rgba(15,23,42,0.08),
                                    14,
                                    0.12,
                                    0,
                                    4
                                );
                      ">

                    <Label fx:id="averageLabel"
                           text="0.0"

                           style="
                                -fx-font-size: 24px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #0ea5e9;
                           "/>

                    <Label text="Moyenne / technicien"
                           style="
                                -fx-font-size: 12px;
                                -fx-text-fill: #64748b;
                           "/>

                </VBox>

            </HBox>

            <!-- CHART CARD -->
            <VBox spacing="10"
                  VBox.vgrow="ALWAYS"

                  style="
                        -fx-background-color: white;

                        -fx-background-radius: 20;

                        -fx-padding: 16;

                        -fx-effect:
                            dropshadow(
                                gaussian,
                                rgba(15,23,42,0.08),
                                18,
                                0.12,
                                0,
                                4
                            );
                  ">

                <Label text="Répartition des véhicules"

                       style="
                            -fx-font-size: 16px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #334155;
                       "/>

                <Label fx:id="chartStatusLabel"
                       text="Chargement du graphique..."

                       style="
                            -fx-font-size: 12px;
                            -fx-text-fill: #94a3b8;
                       "/>

                <BarChart fx:id="vehiculesChart"
                          VBox.vgrow="ALWAYS"

                          animated="false"
                          legendVisible="false"
                          categoryGap="10"

                          style="
                                -fx-background-color: transparent;
                          ">

                    <xAxis>
                        <CategoryAxis fx:id="technicienAxis"/>
                    </xAxis>

                    <yAxis>
                        <NumberAxis fx:id="vehiculesAxis"/>
                    </yAxis>

                </BarChart>

            </VBox>

            <!-- FOOTER -->
            <HBox alignment="CENTER_LEFT"

                  style="
                        -fx-background-color: white;

                        -fx-background-radius: 14;

                        -fx-padding: 10 14;

                        -fx-effect:
                            dropshadow(
                                gaussian,
                                rgba(15,23,42,0.05),
                                10,
                                0.1,
                                0,
                                2
                            );
                  ">

                <Label fx:id="infoLabel"

                       style="
                            -fx-font-size: 13px;
                            -fx-text-fill: #475569;
                       "/>

            </HBox>

        </VBox>

    </center>

</BorderPane>