<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rayen.controllers.displayContoller"
            styleClass="page">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-navbar">
            <padding>
                <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
            </padding>
            <VBox spacing="6.0">
                <Label text="Rayen Fleet Manager" styleClass="nav-brand" />
                <Label text="Navigation rapide entre les modules vehicule et technicien." styleClass="nav-caption" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleOpenChatbot" styleClass="chat-launch-button" text="Assistant IA" />
            <Label text="Navigation principale" styleClass="nav-chip" />
        </HBox>
    </top>
    <left>
        <VBox spacing="14.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="18.0" right="18.0" top="24.0" />
            </padding>
            <Label text="Modules" styleClass="sidebar-title" />
            <Button maxWidth="Infinity" onAction="#handleGoVehicules" styleClass="sidebar-button-active" text="Vehicule" />
            <Button maxWidth="Infinity" onAction="#handleGoTechniciens" styleClass="sidebar-button" text="Technicien" />
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <VBox spacing="16.0" styleClass="page-header">
                    <padding>
                        <Insets bottom="18.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                    <VBox spacing="6.0">
                        <Label text="Gestion des vehicules" styleClass="title-label" />
                        <Label text="Affichage principal du CRUD avec navigation vers l'ajout et la modification." styleClass="subtitle-label" />
                    </VBox>
                    <HBox spacing="12.0">
                        <Button text="Ajouter" onAction="#handleAdd" styleClass="primary-button" />
                        <Button text="Modifier" onAction="#handleModify" styleClass="secondary-button" />
                        <Button text="Supprimer" onAction="#handleDelete" styleClass="danger-button" />
                        <Button text="Generer PDF" onAction="#handleGeneratePdf" styleClass="secondary-button" />
                        <Button text="Actualiser" onAction="#handleRefresh" styleClass="secondary-button" />
                    </HBox>
                </VBox>
            </top>
            <center>
                <VBox spacing="16.0">
                    <padding>
                        <Insets bottom="18.0" left="24.0" right="24.0" top="0.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="search-bar-container">
                        <Label text="Recherche" styleClass="search-caption" />
                        <TextField fx:id="searchField"
                                   promptText="Rechercher par matricule, marque, modele, couleur ou technicien..."
                                   styleClass="search-input"
                                   HBox.hgrow="ALWAYS" />
                        <Button text="Effacer" onAction="#handleClearSearch" styleClass="secondary-button" />
                    </HBox>
                    <TableView fx:id="vehiculeTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="70.0" text="ID" />
                            <TableColumn fx:id="matriculeColumn" prefWidth="140.0" text="Matricule" />
                            <TableColumn fx:id="marqueColumn" prefWidth="130.0" text="Marque" />
                            <TableColumn fx:id="modeleColumn" prefWidth="150.0" text="Modele" />
                            <TableColumn fx:id="couleurColumn" prefWidth="120.0" text="Couleur" />
                            <TableColumn fx:id="prixColumn" prefWidth="130.0" text="Prix location" />
                            <TableColumn fx:id="disponibiliteColumn" prefWidth="150.0" text="Disponibilite" />
                            <TableColumn fx:id="technicienColumn" prefWidth="170.0" text="Technicien" />
                        </columns>
                    </TableView>
                </VBox>
            </center>
            <bottom>
                <HBox styleClass="footer-bar">
                    <padding>
                        <Insets bottom="18.0" left="24.0" right="24.0" top="0.0" />
                    </padding>
                    <Label fx:id="infoLabel" styleClass="info-label" />
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
